#!/usr/bin/env python3
"""A stand-in for Codex that writes the rollout file the real one writes and keeps it open.

  codex [--pattern=cycle|steady|idle] [--windows=both|flap|weekly] [--tokens=N]

Real rollouts carry `token_count` events whose `rate_limits` hold a 5-hour (300 minute) window,
only a weekly window, or nothing. `--windows=flap` reproduces the sequence seen in real sessions,
where the newest event at the end of a turn lacks the 5-hour window.
"""

import os
import sys
import time
from datetime import datetime, timezone
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent.parent))
import labkit  # noqa: E402

WINDOW = 258_400


def rate_limits(windows, used):
    now = int(time.time())
    weekly = {"used_percent": 58.0, "window_minutes": 10080, "resets_at": now + 4 * 86400}
    if windows == "weekly":
        return {"primary": weekly, "secondary": None}
    return {
        "primary": {"used_percent": used, "window_minutes": 300, "resets_at": now + 3 * 3600},
        "secondary": weekly,
    }


def token_count(tokens, windows, used):
    return {
        "type": "event_msg",
        "payload": {
            "type": "token_count",
            "info": {
                "total_token_usage": {"total_tokens": tokens},
                "last_token_usage": {"total_tokens": tokens},
                "model_context_window": WINDOW,
            },
            "rate_limits": rate_limits(windows, used),
        },
    }


def event(kind):
    return {"type": "event_msg", "payload": {"type": kind}}


def main():
    pattern = labkit.option("pattern", "cycle")
    windows = labkit.option("windows", "both")
    tokens = int(labkit.option("tokens", "100000"))
    cwd = Path.cwd()
    stamp = datetime.now(timezone.utc)
    rollout = (
        labkit.home()
        / ".codex"
        / "sessions"
        / f"{stamp:%Y}"
        / f"{stamp:%m}"
        / f"{stamp:%d}"
        / f"rollout-{stamp:%Y-%m-%dT%H-%M-%S}-{labkit.new_id()}.jsonl"
    )
    rollout.parent.mkdir(parents=True, exist_ok=True)
    # The real Codex holds its rollout open, which is how the plate binds the process to it.
    stream = rollout.open("a", encoding="utf-8")

    def write(record):
        import json

        stream.write(json.dumps(record, separators=(",", ":")) + "\n")
        stream.flush()

    labkit.clean_up_on_signal(lambda: None)
    write({"type": "session_meta", "payload": {"id": labkit.new_id(), "cwd": str(cwd)}})
    write(token_count(tokens, "both", 37.0))
    labkit.truth(
        agent="codex", event="start", working=False,
        context_pct=round(tokens / WINDOW * 100), usage_pct=37,
    )
    print("Codex (lab stand-in)")
    turn = 0
    while True:
        if pattern == "idle":
            labkit.idle_for(2.0)
            continue
        if pattern != "steady":
            labkit.idle_for(8.0)
        write(event("task_started"))
        turn += 1
        used = min(99.0, 37.0 + turn)
        labkit.truth(agent="codex", working=True, usage_pct=round(used))
        write(token_count(tokens + turn * 500, "both", used))
        labkit.work_for(6.0 if pattern != "steady" else 2.0, pause_chance=0.0)
        write(token_count(tokens + turn * 900, "both", used))
        final_windows = "weekly" if windows in ("flap", "weekly") else "both"
        write(token_count(tokens + turn * 1000, final_windows, used))
        labkit.truth(agent="codex", context_pct=round((tokens + turn * 1000) / WINDOW * 100))
        if pattern != "steady":
            write(event("task_complete"))
            labkit.truth(agent="codex", working=False)


if __name__ == "__main__":
    main()
