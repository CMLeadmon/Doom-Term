#!/usr/bin/env python3
"""Run the production directory module's tests without the hosted app test dependencies."""
import json
import os
from pathlib import Path
import subprocess
import sys
import tempfile

repo = Path(__file__).resolve().parents[2]
with tempfile.TemporaryDirectory(prefix="doomterm-group-tests-") as scratch:
    root = Path(scratch)
    (root / "src").mkdir()
    (root / "Cargo.toml").write_text('''[package]
name = "doomterm_group_tests"
version = "0.1.0"
edition = "2024"
[workspace]
[dependencies]
serde = { version = "1", features = ["derive"] }
serde_json = "1"
''')
    module = json.dumps(str(repo / "app/src/workspace/group_directory.rs"))
    (root / "src/lib.rs").write_text(f"#[path = {module}]\npub mod group_directory;\n")
    env = dict(os.environ, CARGO_TARGET_DIR=str(repo / "target/group-tests"))
    nextest = subprocess.run(["cargo", "nextest", "--version"], capture_output=True).returncode == 0
    if "--clippy" in sys.argv:
        args = ["cargo", "clippy", "--all-targets", "--manifest-path", str(root / "Cargo.toml"), "--", "-D", "warnings"]
    else:
        args = (["cargo", "nextest", "run"] if nextest else ["cargo", "test"]) + ["--manifest-path", str(root / "Cargo.toml")]
    subprocess.run(args, env=env, check=True)
